<?php
require_once 'admin_auth.php';
require_once '../config/db_connect.php';

// Check if admin is logged in
if (!isset($_SESSION['admin_id'])) {
    header('Location: login.php');
    exit();
}

// Get vehicle ID from URL
$id = isset($_GET['id']) ? (int)$_GET['id'] : 0;

// Fetch vehicle data
$stmt = $pdo->prepare("SELECT * FROM vehicles WHERE id = ?");
$stmt->execute([$id]);
$vehicle = $stmt->fetch();

if (!$vehicle) {
    header('Location: dashboard.php?error=vehicle_not_found');
    exit();
}

$success_message = '';
$error_message = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        // Create upload directory if it doesn't exist
        $upload_dir = '../assets/images/vehicles/';
        if (!file_exists($upload_dir)) {
            mkdir($upload_dir, 0755, true);
        }
        
        // Function to handle file upload
        function handleFileUpload($file, $upload_dir) {
            if ($file['error'] === 0) {
                // Validate file type
                $allowed_types = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                if (!in_array($file['type'], $allowed_types)) {
                    throw new Exception('Invalid file type. Only JPG, PNG, GIF, and WebP are allowed.');
                }
                
                // Check file size (5MB max)
                if ($file['size'] > 5 * 1024 * 1024) {
                    throw new Exception('File too large. Maximum size is 5MB.');
                }
                
                $filename = uniqid() . '_' . basename($file['name']);
                $target_path = $upload_dir . $filename;
                
                if (move_uploaded_file($file['tmp_name'], $target_path)) {
                    return 'assets/images/vehicles/' . $filename;
                }
                throw new Exception('Failed to upload file: ' . $file['name']);
            }
            return null;
        }

        // Validate required fields
        if (empty($_POST['brand']) || empty($_POST['model']) || empty($_POST['price_per_day'])) {
            throw new Exception('Please fill in all required fields.');
        }

        // Build update query
        $sql = "UPDATE vehicles SET 
                brand = ?, 
                model = ?, 
                price_per_day = ?, 
                gear_box = ?, 
                fuel_type = ?, 
                max_speed = ?, 
                capacity = ?, 
                fuel_tank = ?, 
                mileage = ?";

        $params = [
            $_POST['brand'],
            $_POST['model'],
            $_POST['price_per_day'],
            $_POST['gear_box'],
            $_POST['fuel_type'],
            $_POST['max_speed'],
            $_POST['capacity'],
            $_POST['fuel_tank'],
            $_POST['mileage']
        ];

        // Handle image updates
        if (isset($_FILES['main_image']) && $_FILES['main_image']['error'] === 0) {
            $main_image = handleFileUpload($_FILES['main_image'], $upload_dir);
            if ($main_image) {
                $sql .= ", main_image = ?";
                $params[] = $main_image;
                
                // Delete old main image
                if ($vehicle['main_image'] && file_exists('../' . $vehicle['main_image'])) {
                    unlink('../' . $vehicle['main_image']);
                }
            }
        }
        
        if (isset($_FILES['image1']) && $_FILES['image1']['error'] === 0) {
            $image1 = handleFileUpload($_FILES['image1'], $upload_dir);
            if ($image1) {
                $sql .= ", image1 = ?";
                $params[] = $image1;
                
                // Delete old image1
                if ($vehicle['image1'] && file_exists('../' . $vehicle['image1'])) {
                    unlink('../' . $vehicle['image1']);
                }
            }
        }
        
        if (isset($_FILES['image2']) && $_FILES['image2']['error'] === 0) {
            $image2 = handleFileUpload($_FILES['image2'], $upload_dir);
            if ($image2) {
                $sql .= ", image2 = ?";
                $params[] = $image2;
                
                // Delete old image2
                if ($vehicle['image2'] && file_exists('../' . $vehicle['image2'])) {
                    unlink('../' . $vehicle['image2']);
                }
            }
        }
        
        if (isset($_FILES['image3']) && $_FILES['image3']['error'] === 0) {
            $image3 = handleFileUpload($_FILES['image3'], $upload_dir);
            if ($image3) {
                $sql .= ", image3 = ?";
                $params[] = $image3;
                
                // Delete old image3
                if ($vehicle['image3'] && file_exists('../' . $vehicle['image3'])) {
                    unlink('../' . $vehicle['image3']);
                }
            }
        }

        $sql .= " WHERE id = ?";
        $params[] = $id;

        $stmt = $pdo->prepare($sql);
        $success = $stmt->execute($params);

        if ($success) {
            // Clear any output buffers
            ob_clean();
            
            // Redirect to dashboard with success message
            header('Location: dashboard.php?success=vehicle_updated');
            exit();
        } else {
            throw new Exception('Failed to update vehicle.');
        }
        
    } catch (Exception $e) {
        $error_message = $e->getMessage();
        
        // Refresh vehicle data after error
        $stmt = $pdo->prepare("SELECT * FROM vehicles WHERE id = ?");
        $stmt->execute([$id]);
        $vehicle = $stmt->fetch();
    }
}

